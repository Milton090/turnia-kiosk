<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:r="clr-namespace:TurniaKiosk.Resources.Styles"
    x:Class="TurniaKiosk.Resources.Styles.ButtonStyles">

    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="Scale" Value="1.0"/>
        <Setter Property="FontFamily" Value="InterMedium"/>
        <Style.Triggers>
            <Trigger TargetType="Button" Property="IsPressed" Value="True">
                <Setter Property="Scale" Value="0.95"/>
            </Trigger>
            <Trigger TargetType="Button" Property="IsPressed" Value="False">
                <Setter Property="Scale" Value="1.0"/>
            </Trigger>
        </Style.Triggers>
    </Style>


<Style x:Key="Imgstyle" TargetType="ImageButton">
        <Setter Property="Scale" Value="1.0"/>
        <Style.Triggers>
            <Trigger TargetType="ImageButton" Property="IsPressed" Value="True">
                <Setter Property="Scale" Value="0.90"/>
            </Trigger>
            <Trigger TargetType="ImageButton" Property="IsPressed" Value="False">
                <Setter Property="Scale" Value="1.0"/>
            </Trigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>


