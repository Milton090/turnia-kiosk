<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurniaKiosk.Pages.TicketCreation"
             xmlns:c="clr-namespace:TurniaKiosk.Components"
             xmlns:local="clr-namespace:TurniaKiosk.ViewModels.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:Logo Grid.Row="0" />

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center">
            <Label  Text="Creando su ticket" HorizontalOptions="Center" FontSize="Header" Margin="0,0,0,60" />

            <Label  Text="{Binding TicketNumber}" IsVisible="{Binding IsVisible}" HorizontalOptions="Center" FontSize="Header" Margin="0,0,0,60"></Label>

        </VerticalStackLayout>
       
    </Grid>

</ContentPage>